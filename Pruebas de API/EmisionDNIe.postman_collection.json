    "name": "EmisionDNIe - Pruebas de Aceptación (BDD)",
    "description": "Colección de pruebas de aceptación para el servicio REST de Solicitudes de DNIe, organizada por feature siguiendo el enfoque BDD (Given-When-Then).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "56917524",
    "_collection_link": "https://go.postman.co/collection/56917524-a699fdbc-f9b4-47ca-a3d5-1dff2655aa0a?source=collection_link"
  },
  "item": [
    {
      "name": "Feature - Registrar Solicitud DNIe",
      "item": [
        {
          "name": "Crear solicitud de DNIe (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// GIVEN un ciudadano con DNI valido de 8 digitos y datos completos"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// WHEN se envia un POST a /api/solicitudes-dnie",
                  "",
                  "// THEN la respuesta es 201 Created",
                  "pm.test('Status code es 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('La solicitud fue creada con estado REGISTRADA', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id_solicitud).to.be.a('number');",
                  "    pm.expect(jsonData.estado).to.eql('REGISTRADA');",
                  "    pm.expect(jsonData.dni_ciudadano).to.eql('12345678');",
                  "});",
                  "",
                  "// Se guarda el id generado para reutilizarlo en los siguientes requests",
                  "pm.environment.set('id_solicitud_creada', pm.response.json().id_solicitud);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"dni_ciudadano\":\"12345678\",\"nombres\":\"Juan\",\"apellidos\":\"Perez\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/solicitudes-dnie",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "solicitudes-dnie"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Rechazar solicitud con DNI invalido (400)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// GIVEN un DNI con menos de 8 digitos"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// WHEN se envia el POST",
                  "",
                  "// THEN la respuesta es 400 Bad Request con un mensaje de error informativo",
                  "pm.test('Status code es 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('El mensaje de error es informativo', function () {",
                  "    pm.expect(pm.response.json()).to.have.property('error');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"dni_ciudadano\":\"123\",\"nombres\":\"Juan\",\"apellidos\":\"Perez\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/solicitudes-dnie",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "solicitudes-dnie"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Feature - Consultar Solicitud DNIe",
      "item": [
        {
          "name": "Consultar solicitud existente (200)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// GIVEN una solicitud previamente registrada (id_solicitud_creada)"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// WHEN se envia un GET a /api/solicitudes-dnie/{id}",
                  "",
                  "// THEN la respuesta es 200 OK",
                  "pm.test('Status code es 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// AND el id retornado coincide con el solicitado",
                  "pm.test('El id retornado coincide con el solicitado', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(String(jsonData.id_solicitud)).to.eql(String(pm.environment.get('id_solicitud_creada')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/solicitudes-dnie/{{id_solicitud_creada}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "solicitudes-dnie",
                "{{id_solicitud_creada}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Consultar solicitud inexistente (404)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// GIVEN un ID que no existe en el sistema"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// WHEN se envia un GET a /api/solicitudes-dnie/999999",
                  "",
                  "// THEN la respuesta es 404 Not Found",
                  "pm.test('Status code es 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/solicitudes-dnie/999999",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "solicitudes-dnie",
                "999999"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Feature - Listar Solicitudes DNIe",
      "item": [
        {
          "name": "Listar todas las solicitudes (200)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// GIVEN que existe al menos una solicitud registrada previamente"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// WHEN se envia un GET a /api/solicitudes-dnie",
                  "",
                  "// THEN la respuesta debe ser 200 OK",
                  "pm.test('Status code es 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// AND debe retornar un arreglo no vacio",
                  "pm.test('La lista de solicitudes no esta vacia', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    pm.expect(jsonData.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/solicitudes-dnie",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "solicitudes-dnie"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Feature - Actualizar Solicitud DNIe",
      "item": [
        {
          "name": "Cambiar estado a HUELLAS_CAPTURADAS (200)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// GIVEN una solicitud en estado REGISTRADA (id_solicitud_creada)"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// WHEN se envia un PUT cambiando el estado a HUELLAS_CAPTURADAS\r",
                  "\r",
                  "     pm.test('Status code es 200', function () {\r",
                  "         pm.response.to.have.status(200);\r",
                  "     });\r",
                  "\r",
                  "     pm.test('El estado fue actualizado correctamente', function () {\r",
                  "         pm.expect(pm.response.json().estado).to.eql('HUELLAS_CAPTURADAS');\r",
                  "     });"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\"estado\": \"HUELLAS_CAPTURADAS\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/solicitudes-dnie/{{id_solicitud_creada}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "solicitudes-dnie",
                "{{id_solicitud_creada}}"
              ]
            }
          },
          "response": []
